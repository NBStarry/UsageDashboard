{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenDeck",
  "version": "1.0.0",
  "identifier": "app.usagedashboard",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TokenDeck",
        "width": 360,
        "height": 600,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "visible": false,
        "transparent": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/tray.png",
      "icons/tray-alert.png"
    ],
    "publisher": "Starry Bei",
    "shortDescription": "TokenDeck system tray app for monitoring Claude, Codex, and New-API usage"
  }
}
