<?xml version="1.0" encoding="utf-8"?>
<!-- 2x2 双服务小组件。一个卡片内上下两块,各显示一个渠道。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dw_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top"
    android:background="@drawable/widget_bg"
    android:paddingLeft="11dp"
    android:paddingRight="11dp"
    android:paddingTop="7dp"
    android:paddingBottom="7dp">

    <LinearLayout
        android:id="@+id/dw_top_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/dw_top_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="3dp">
            <TextView
                android:id="@+id/dw_top_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#8E8E93"
                android:textSize="10sp"
                android:paddingEnd="5dp" />
            <TextView
                android:id="@+id/dw_top_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/dw_top_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#6E6E73"
                android:textSize="8sp"
                android:paddingEnd="7dp" />
            <LinearLayout
                android:id="@+id/dw_refresh_hit"
                android:layout_width="34dp"
                android:layout_height="26dp"
                android:gravity="center"
                android:clickable="true"
                android:contentDescription="刷新">
                <ImageView
                    android:id="@+id/dw_refresh"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:padding="4dp"
                    android:background="@drawable/widget_action_bg"
                    android:src="@drawable/widget_refresh_icon"
                    android:tint="#E6FFFFFF"
                    android:scaleType="center"
                    android:clickable="true"
                    android:contentDescription="刷新" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dw_top_windows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/dw_top_win0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/dw_top_win0_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="#C8C8CC"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/dw_top_win0_reset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#6E6E73"
                        android:textSize="8sp"
                        android:paddingEnd="6dp" />
                    <TextView
                        android:id="@+id/dw_top_win0_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/dw_top_win0_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dw_top_win1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/dw_top_win1_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="#C8C8CC"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/dw_top_win1_reset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#6E6E73"
                        android:textSize="8sp"
                        android:paddingEnd="6dp" />
                    <TextView
                        android:id="@+id/dw_top_win1_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/dw_top_win1_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dw_top_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/dw_top_bal_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/dw_top_bal_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#8E8E93"
                android:textSize="10sp"
                android:paddingTop="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/dw_top_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#8E8E93"
            android:textSize="11sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/dw_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2C2C2E"
        android:text="" />

    <LinearLayout
        android:id="@+id/dw_bottom_block"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="6dp">

        <LinearLayout
            android:id="@+id/dw_bottom_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="3dp">
            <TextView
                android:id="@+id/dw_bottom_dot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="●"
                android:textColor="#8E8E93"
                android:textSize="10sp"
                android:paddingEnd="5dp" />
            <TextView
                android:id="@+id/dw_bottom_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="13sp"
                android:textStyle="bold"
                android:singleLine="true"
                android:ellipsize="end" />
            <TextView
                android:id="@+id/dw_bottom_updated"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#6E6E73"
                android:textSize="8sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dw_bottom_windows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <LinearLayout
                android:id="@+id/dw_bottom_win0"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/dw_bottom_win0_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="#C8C8CC"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/dw_bottom_win0_reset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#6E6E73"
                        android:textSize="8sp"
                        android:paddingEnd="6dp" />
                    <TextView
                        android:id="@+id/dw_bottom_win0_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/dw_bottom_win0_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/dw_bottom_win1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="4dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/dw_bottom_win1_label"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text=""
                        android:textColor="#C8C8CC"
                        android:textSize="11sp"
                        android:singleLine="true"
                        android:ellipsize="end" />
                    <TextView
                        android:id="@+id/dw_bottom_win1_reset"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#6E6E73"
                        android:textSize="8sp"
                        android:paddingEnd="6dp" />
                    <TextView
                        android:id="@+id/dw_bottom_win1_pct"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="#FFFFFFFF"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
                <ProgressBar
                    android:id="@+id/dw_bottom_win1_bar"
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="match_parent"
                    android:layout_height="5dp"
                    android:layout_marginTop="2dp"
                    android:max="100"
                    android:progress="0"
                    android:progressDrawable="@drawable/widget_progress" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/dw_bottom_balance"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView
                android:id="@+id/dw_bottom_bal_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#FFFFFFFF"
                android:textSize="19sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/dw_bottom_bal_sub"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="#8E8E93"
                android:textSize="10sp"
                android:paddingTop="1dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/dw_bottom_status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#8E8E93"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>
