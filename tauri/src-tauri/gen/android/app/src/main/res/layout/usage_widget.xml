<?xml version="1.0" encoding="utf-8"?>
<!-- 主屏小组件布局(RemoteViews 兼容:仅 LinearLayout / TextView)。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_bg"
    android:padding="14dp">

    <!-- 头部:标题 + 更新时间 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="8dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="订阅用量"
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/w_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textColor="#8E8E93"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 行 0 -->
    <LinearLayout android:id="@+id/w_row0"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
        <TextView android:id="@+id/w_dot0" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="●" android:textColor="#8E8E93" android:textSize="10sp"
            android:paddingEnd="8dp" android:paddingTop="2dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_title0" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_l1_0" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#D8D8DA" android:textSize="12sp" />
            <TextView android:id="@+id/w_l2_0" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#8E8E93" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 行 1 -->
    <LinearLayout android:id="@+id/w_row1"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
        <TextView android:id="@+id/w_dot1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="●" android:textColor="#8E8E93" android:textSize="10sp"
            android:paddingEnd="8dp" android:paddingTop="2dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_title1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_l1_1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#D8D8DA" android:textSize="12sp" />
            <TextView android:id="@+id/w_l2_1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#8E8E93" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- 行 2 -->
    <LinearLayout android:id="@+id/w_row2"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="6dp" android:paddingBottom="6dp">
        <TextView android:id="@+id/w_dot2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="●" android:textColor="#8E8E93" android:textSize="10sp"
            android:paddingEnd="8dp" android:paddingTop="2dp" />
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/w_title2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#FFFFFFFF" android:textSize="13sp" android:textStyle="bold" />
            <TextView android:id="@+id/w_l1_2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#D8D8DA" android:textSize="12sp" />
            <TextView android:id="@+id/w_l2_2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="#8E8E93" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
